# NEXT_PUBLIC_API_BASE_URL — URL of the Express backend
# Local: http://localhost:8000
# Production (Render): https://your-app.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional AWS Cognito — leave BOTH blank to run in demo mode (no AWS required).
# When blank, the app uses a seeded demo user and skips authentication entirely.
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=
